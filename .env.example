# Copy to .env.local and fill in. Never commit the real values.

# The public origin, no trailing slash. Used for canonical URLs, OG images,
# the sitemap and the RSS feed — getting this wrong quietly breaks SEO.
PUBLIC_SITE_URL="http://localhost:4321"

# Written automatically by `pnpm convex:dev` the first time you run it.
CONVEX_URL="https://your-deployment.convex.cloud"
CONVEX_DEPLOYMENT="dev:your-deployment"

# The PIN that unlocks /write.
WRITE_PIN="123456"

# Signs the editor session cookie. Any long random string:
#   openssl rand -hex 32
AUTH_SECRET="change-me-to-something-long-and-random"

# Shared secret between this server and Convex, so nobody else can write to
# the database. Must match the value set on the deployment with:
#   npx convex env set WRITE_TOKEN "<same value>"
WRITE_TOKEN="change-me-too"

# --- Newsletter (Resend) -------------------------------------------------
# Optional: leave unset and the subscribe form still records addresses, it
# just won't send the confirmation email.
RESEND_API_KEY="re_..."
# Must be a verified domain in Resend, e.g. "Muhammad Anas <journal@your-domain.com>"
NEWSLETTER_FROM="Muhammad Anas <journal@your-domain.com>"
# Optional. Defaults to site.email from src/config.js.
NEWSLETTER_REPLY_TO=""
