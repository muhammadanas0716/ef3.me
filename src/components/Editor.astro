    z-index: 20;
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .scrim.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(24rem, 100vw);
    background: var(--color-paper);
    border-left: 1px solid var(--color-rule);
    z-index: 30;
    display: flex;
    flex-direction: column;
    box-shadow: -16px 0 40px -24px rgba(28, 25, 23, 0.4);
    /* Closed: parked off-screen. `visibility` is transitioned too, so the
       panel stays rendered for the whole slide out and only then leaves the
       accessibility tree. */
    translate: 100% 0;
    visibility: hidden;
    transition:
      translate 260ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 260ms;
  }

  .panel.is-open {
    translate: 0 0;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      transition-duration: 1ms;
