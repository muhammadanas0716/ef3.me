---
import { site } from '../config.js';
import { jsonLd, ogUrl, metaDescription } from '../lib/seo.js';
// Imported for its built URL so the body font can be preloaded — it is the
// largest contentful paint on every page, so fetching it in parallel with the
// stylesheet rather than after it is the single biggest perf win available.
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

const {
  title,
  description = site.description,
  /** Full page title override; otherwise `title — shortName`. */
  fullTitle,
  canonical = Astro.url.pathname,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  schemas = [],
} = Astro.props;

// `site.url` is the single source of truth so canonical, OG and feed URLs can
// never disagree with each other.
const canonicalUrl = new URL(canonical, `${site.url}/`).toString();
const pageTitle = fullTitle ?? (title ? `${title} — ${site.shortName}` : `${site.name} — ${site.shortName}`);
const ogImage = new URL(image ?? ogUrl(), site.url).toString();
const clean = (value) => String(value ?? '').replace(/\s+/g, ' ').trim();
const summary = metaDescription(description);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{clean(pageTitle)}</title>
<meta name="description" content={clean(description)} />
<link rel="canonical" href={canonicalUrl} />

{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

<meta name="author" content={site.name} />
<meta name="theme-color" content="#feeccf" />
<meta name="color-scheme" content="light" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={clean(title ?? site.name)} />
<meta property="og:description" content={clean(description)} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={site.shortName} />
<meta property="og:locale" content={site.locale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={clean(imageAlt ?? title ?? site.name)} />

{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{type === 'article' && <meta property="article:author" content={site.name} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={clean(title ?? site.name)} />
<meta name="twitter:description" content={clean(description)} />
<meta name="twitter:image" content={ogImage} />
{site.twitter && <meta name="twitter:creator" content={`@${site.twitter}`} />}
{site.twitter && <meta name="twitter:site" content={`@${site.twitter}`} />}

<link rel="alternate" type="application/rss+xml" title={`${site.name} — ${site.blogTitle}`} href="/rss.xml" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />

{schemas.map((schema) => (
  <script type="application/ld+json" is:inline set:html={jsonLd(schema)} />
))}
