---
/**
 * A quiet "subscribe" link that expands an email field underneath it.
 *
 * No modal and no overlay, clicking toggles a disclosure that grows into
 * place. The height animation is pure CSS (`grid-template-rows: 0fr → 1fr`),
 * which animates smoothly without anyone having to measure the element, so
 * the only JavaScript here is the toggle and the fetch.
 */
const { source = 'blog' } = Astro.props;
---

<div class="subscribe" data-subscribe>
  <p class="top mono dim">
    <button
      type="button"
      class="trigger mono"
      aria-expanded="false"
      aria-controls="subscribe-panel"
      data-toggle
    >
      subscribe
    </button>
    <!-- Anything else that belongs on this line, e.g. the feed link. -->
    <slot />
  </p>

  <div class="panel" id="subscribe-panel" data-panel>
    <div class="panel-inner">
      <form data-form novalidate data-source={source}>
        <label class="sr-only" for="subscribe-email">Email address</label>
        <div class="row">
          <input
            id="subscribe-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder="you@example.com"
            spellcheck="false"
            required
          />
          <button type="submit">→</button>
        </div>
      </form>
      <p class="note mono" data-note role="status" aria-live="polite">
        New posts only, the topic, a line about it, and a link. One click to leave.
      </p>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-subscribe]').forEach((root) => {
    const toggle = root.querySelector('[data-toggle]');
    const panel = root.querySelector('[data-panel]');
    const form = root.querySelector('[data-form]');
    const input = root.querySelector('input');
    const note = root.querySelector('[data-note]');
    const submit = form.querySelector('button[type="submit"]');

    const setNote = (message, tone = '') => {
      note.textContent = message;
      note.className = `note mono ${tone}`;
    };

    toggle.addEventListener('click', () => {
      const open = root.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      // Focus only once the panel has finished growing, so the browser
      // doesn't scroll to a box that is still mid-animation.
      if (open) setTimeout(() => input.focus(), 180);
    });

    // Escape closes it, matching what the modal used to do.
    root.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !root.classList.contains('is-open')) return;
      root.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.focus();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = input.value.trim();

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        setNote('That doesn’t look like an email address.', 'bad');
        input.focus();
        return;
      }

      submit.disabled = true;
      setNote('Sending…');

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, source: form.dataset.source }),
        });
        const data = await response.json().catch(() => ({}));

        if (response.ok) {
          // Nothing left to do here, retire the form and leave the message.
          form.remove();
          setNote('Check your inbox and click the confirmation link.', 'good');
        } else {
          setNote(data.error ?? 'Something went wrong. Try again?', 'bad');
        }
      } catch {
        setNote('Network error. Try again?', 'bad');
      } finally {
        submit.disabled = false;
      }
    });
  });
</script>

<style>
  .subscribe {
    display: block;
  }

  .top {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .trigger {
    background: none;
    border: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-thickness 90ms ease;
  }

  .trigger:hover.subscribe.is-open .trigger {
    text-decoration-thickness: 2px;
  }

  /* The disclosure. A 0fr → 1fr grid row animates height without JS having
     to measure anything, and stays correct if the content reflows. */
  .panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 240ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 160ms ease,
      margin-top 240ms cubic-bezier(0.22, 1, 0.36, 1);
    margin-top: 0;
  }

  .subscribe.is-open .panel {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: 0.85rem;
  }

  .panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  .row {
    display: flex;
    gap: 0.4rem;
    max-width: 22rem;
  }

  input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    padding: 0.5rem 0.7rem;
    background: #fffaf1;
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    color: var(--color-ink);
    transition: border-color 120ms ease;
  }

  input::placeholder {
    color: var(--color-ink-faint);
  }

  input:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  button[type='submit'] {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    padding: 0.5rem 0.85rem;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 0;
    border-radius: 4px;
    cursor: pointer;
    transition: background 120ms ease;
  }

  button[type='submit']:hover:not(:disabled) {
    background: var(--color-accent-deep);
  }

  button[type='submit']:disabled {
    opacity: 0.55;
    cursor: default;
  }

  .note {
    margin-top: 0.5rem;
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
    max-width: 24rem;
    line-height: 1.55;
  }

  .note.bad {
    color: #9a3412;
  }

  .note.good {
    color: #15803d;
  }
</style>
