---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Subscribe from '../../components/Subscribe.astro';
import { site } from '../../config.js';
import { safeQuery } from '../../lib/convex.js';
import { api } from '../../../convex/_generated/api.js';
import { blogSchema, breadcrumbSchema, itemListSchema } from '../../lib/seo.js';

const posts = await safeQuery(api.posts.listPublished, {}, []);
const tags = await safeQuery(api.posts.tagCounts, {}, []);

Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=604800');
---

<Base
  title={site.blogTitle}
  description={site.blogDescription}
  canonical="/blog"
  schemas={[
    blogSchema(posts),
    itemListSchema(posts, { name: `${site.blogTitle}, all posts`, url: '/blog' }),
    breadcrumbSchema([
      { name: 'Home', href: '/' },
      { name: site.blogTitle, href: '/blog' },
    ]),
  ]}
>
  <h1>{site.blogTitle}</h1>
  <p class="lede">{site.blogDescription}</p>

  {tags.length > 0 && (
    <div class="tag-block" data-tags>
      <button type="button" class="mono tag-toggle" aria-expanded="true" aria-controls="tag-list" data-tag-toggle>
        <span data-tag-verb>hide</span> tags
        <span class="dim">({tags.length})</span>
      </button>

      <div class="tag-panel" id="tag-list">
        <ul class="tags mono">
          {tags.map((entry) => (
            <li>
              <a class="tag" href={`/tags/${encodeURIComponent(entry.tag)}`}>
                {entry.tag}<span class="tag-count">{entry.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <PostList posts={posts} empty="No posts yet. The first one is being written." />

  <div class="feed">
    <Subscribe source="blog">
      <span aria-hidden="true">&nbsp;·&nbsp;</span>
      <a href="/rss.xml">rss</a>
    </Subscribe>
  </div>
  <script>
    // Remembers itself, because someone who hides the tags once probably
    // wants them hidden next time too.
    const block = document.querySelector('[data-tags]');
    if (block) {
      const toggle = block.querySelector('[data-tag-toggle]');
      const verb = block.querySelector('[data-tag-verb]');
      const KEY = 'el:tags-hidden';

      const apply = (hidden) => {
        block.classList.toggle('is-hidden', hidden);
        toggle.setAttribute('aria-expanded', String(!hidden));
        verb.textContent = hidden ? 'show' : 'hide';
      };

      try {
        if (localStorage.getItem(KEY) === '1') apply(true);
      } catch {
        /* storage blocked; just leave them showing */
      }

      toggle.addEventListener('click', () => {
        const hidden = !block.classList.contains('is-hidden');
        apply(hidden);
        try {
          localStorage.setItem(KEY, hidden ? '1' : '0');
        } catch {
          /* ignore */
        }
      });
    }
  </script>
</Base>

<style>
  h1 {
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.017em;
  }

  .lede {
    margin-top: 0.6rem;
    color: var(--color-ink-soft);
    max-width: 30rem;
  }

  .tag-block {
    margin-top: 1.25rem;
  }

  .tag-toggle {
    background: none;
    border: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    cursor: pointer;
    transition: color 120ms ease;
  }

  .tag-toggle:hover {
    color: var(--color-ink);
  }

  /* Same 0fr to 1fr trick the subscribe field uses: animates height with no
     measuring, and stays correct if the tags wrap onto another line. */
  .tag-panel {
    display: grid;
    grid-template-rows: 1fr;
    margin-top: 0.7rem;
    transition:
      grid-template-rows 220ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 160ms ease,
      margin-top 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tag-block.is-hidden .tag-panel {
    grid-template-rows: 0fr;
    opacity: 0;
    margin-top: 0;
  }

  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Pills rather than underlined links, so a row of them reads as one set
     of filters instead of eight separate sentences. */
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    text-decoration: none;
    color: var(--color-ink);
    line-height: 1.4;
    transition:
      background 120ms ease,
      border-color 120ms ease;
  }

  .tag:hover {
    background: color-mix(in srgb, var(--color-accent) 28%, transparent);
    border-color: var(--color-accent);
  }

  .tag-count {
    font-size: 0.6875rem;
    color: var(--color-accent-deep);
  }

  .feed {
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-rule);
  }
</style>
